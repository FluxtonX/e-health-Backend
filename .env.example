PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ehealth_db?schema=public"
JWT_SECRET="your_jwt_secret_change_in_production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_change_in_production"
JWT_REFRESH_EXPIRATION="7d"
API_PREFIX="v1"
CORS_ALLOWED_ORIGINS="http://localhost:3001"

# Brevo Transactional Email Configuration
# Option A (Recommended): REST API Key from Brevo Dashboard -> SMTP & API -> "API Keys" tab (starts with "xkeysib-...")
# Option B: SMTP Relay Key from Brevo Dashboard -> SMTP & API -> "SMTP" tab (starts with "xsmtpsib-...")
BREVO_API_KEY="replace-with-brevo-key"
BREVO_SENDER_EMAIL="verified-sender@example.com"
BREVO_SENDER_NAME="United Union Health"
# Optional: if using an xsmtpsib- key and your Brevo SMTP login is different from BREVO_SENDER_EMAIL:
# BREVO_SMTP_LOGIN="your-brevo-smtp-login@smtp-brevo.com"

# Optional integrations. Keep disabled until a real provider is configured.
ESIM_PROVIDER_ENABLED="false"
SEED_DEMO_ON_REGISTER="false"
USDA_FDC_API_KEY="replace-with-usda-fooddata-central-key"
FOOD_VISION_URL="http://127.0.0.1:8001"
FOOD_RECOGNITION_THRESHOLD="0.60"
